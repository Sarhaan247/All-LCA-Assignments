   "source": [
    "import re\n",
    "\n",
    "string = input(\"Enter a string: \")\n",
    "\n",
    "if re.fullmatch(r'[a-zA-Z0-9]+', string):\n",
    "    print(\"The string contains only a-z, A-Z and 0-9 characters.\")\n",
    "else:\n",
    "    print(\"The string contains characters other than a-z, A-Z and 0-9.\")"
   ]
